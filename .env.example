# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — do not commit real secrets.

# Figma personal access token. Required for both:
#   - the `fetch-figma-vars` skill / `npm run tokens:pull`
#   - any skill that calls the Figma REST API
# Generate at: https://www.figma.com/settings (Personal access tokens)
FIGMA_PAT=

# Figma file key. The string between /design/ and the next slash in a Figma URL.
# Required only by `fetch-figma-vars` / `npm run tokens:pull`.
# Leave empty if you only use the compose-layout skill (which reads via Figma MCP).
FIGMA_FILE_KEY=

# Centralized shadcn component library that target repos consume.
# Referenced by the compose-layout skill when looking up Code Connect imports.
# Set both to match your team's design system.
SHADCN_COMPONENT_LIBRARY=visual-to-code-prototype
SHADCN_COMPONENT_LIBRARY_PACKAGE=@thuan/components
