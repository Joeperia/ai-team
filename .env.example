# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — do not commit real secrets.

# Figma personal access token. Required for both:
#   - the `fetch-figma-vars` skill / `npm run tokens:pull`
#   - any skill that calls the Figma REST API
# Generate at: https://www.figma.com/settings (Personal access tokens)
FIGMA_PAT=

# Figma file key. The string between /design/ and the next slash in a Figma URL.
# Required only by `fetch-figma-vars` / `npm run tokens:pull`.
# Leave empty if you only use the implement-design skill (which reads via Figma MCP).
FIGMA_FILE_KEY=

# Canonical name of the centralized design-system library.
# Skills read this via $APERIA_DS to refer to "our library" as a concept.
# The per-target runtime variable $APERIA_DS_PACKAGE (the actual import name in a
# given target repo, possibly aliased) is detected at runtime by each skill.
# See .claude/skills/CONVENTIONS.md for the env-vs-runtime convention.
APERIA_DS=aperia-ds5
